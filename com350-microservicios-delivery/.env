# ===== Variables usadas por docker-compose.yml =====

# Secreto JWT compartido por los CUATRO microservicios
JWT_SECRET=deliverySucre2026superSecreto

# MySQL (restaurantes y platos)
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=bd_restaurantes
MYSQL_USER=delivery
MYSQL_PASSWORD=delivery123
MYSQL_PORT=3306

# MongoDB (usuarios)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=bd_usuarios
