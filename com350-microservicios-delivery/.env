# PostgreSQL (pedidos en Laravel y entregas en Node)
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery123
POSTGRES_DB_ORDERS=bd_pedidos
POSTGRES_DB_DELIVERIES=bd_entregas
POSTGRES_PORT=5432

# Nginx
NGINX_PORT=80
